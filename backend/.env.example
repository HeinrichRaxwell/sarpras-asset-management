# Copy this file to .env and adjust values

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Docker host port default 5433 to avoid clash with other local PG)
DATABASE_URL=postgres://sarpras:sarpras_secret@localhost:5433/sarpras

# JWT
JWT_SECRET=change_this_secret_in_production_use_long_random_string
JWT_EXPIRES=7d

# Password hashing
BCRYPT_ROUNDS=12

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080