# ===== WAJIB DIISI SEBELUM PRODUCTION =====
# Copy ke .env lalu isi semua nilai. Jangan commit file .env.

# --- PostgreSQL ---
POSTGRES_DB=sarpras
POSTGRES_USER=sarpras
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
# Jangan expose port DB ke host di production (lihat docker-compose.prod.yml)

# --- JWT ---
# Generate: openssl rand -base64 48
# TANPA ini, API memakai fallback 'change_this_secret_in_production' = token bisa dipalsukan
JWT_SECRET=
JWT_EXPIRES=8h

# --- Ports ---
WEB_PORT=8080
API_PORT=3001
DB_PORT=5433

# --- CORS (domain asli, jangan '*') ---
CORS_ORIGINS=https://sarpras.example.com
